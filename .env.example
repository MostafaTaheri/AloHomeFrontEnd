# Base URL of the AloHome API (without /api/v1). Server-side only, never exposed to the browser.
API_BASE_URL=http://localhost:5028
# API version segment used in /api/v{version}/...
API_VERSION=1

# Client cookie names. Keep them identical to Authentication:Cookie in the API settings.
AUTH_ACCESS_COOKIE=alohomeAccessToken
AUTH_REFRESH_COOKIE=alohomeRefreshToken
# Back-office cookie names. Local to this app, must differ from the client names.
BACKOFFICE_ACCESS_COOKIE=alohomeBoAccessToken
BACKOFFICE_REFRESH_COOKIE=alohomeBoRefreshToken

# Defaults to true in production and false otherwise. Only set false for plain-http staging.
# COOKIE_SECURE=true
# Set when the app is served on a parent domain shared with other apps.
# COOKIE_DOMAIN=

# Upstream request timeout in milliseconds.
BACKEND_TIMEOUT_MS=15000
# Upstream timeout for imports and report downloads.
UPLOAD_TIMEOUT_MS=60000
# Largest accepted import file in bytes (20 MB). Keep it equal to the API's own limit.
MAX_UPLOAD_BYTES=20971520

# Comma-separated origins allowed to call mutating BFF endpoints. Defaults to the request host.
# ALLOWED_ORIGINS=https://app.example.com
